# Copy these two names into Vercel > Project > Settings > Environment Variables.
# For local testing only: copy this file to .env.local and fill it in.

# The Web App URL you get after deploying the Apps Script (ends with /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/PASTE_YOUR_DEPLOYMENT_ID_HERE/exec

# A long random password. It MUST be identical to SHARED_SECRET in Apps Script > Project Settings > Script Properties.
APPS_SCRIPT_SECRET=PASTE_A_LONG_RANDOM_SECRET_HERE
